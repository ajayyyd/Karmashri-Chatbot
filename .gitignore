# Directories you explicitly want to exclude
go_ingest/
GO/

# Virtual Environment
venv/
.venv/
env/

# Python compiled bytecode & cache
__pycache__/
*.py[cod]
*$py.class
src/__pycache__/
src/temp/__pycache__/
.pytest_cache/

# Scratch & experimental test scripts
src/temp/

# Large binaries, local database engines & vector storage
qdrant_storage/
pgdata/
*.sqlite3

# PDF data directories (ignore all files except .gitkeep)
data/pdf/*
!data/pdf/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/dead_letter/*
!data/dead_letter/.gitkeep

# Environment secrets
.env
.env.local

# Operating system & IDE junk
.DS_Store
.vscode/
.idea/